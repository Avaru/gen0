{
  "name": "gen0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check": "run-s lint:check \"test:unit -- --run\" build",
    "lint": "run-s \"lint:*\"",
    "lint:check": "oxlint . && eslint .",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24"
  }
}
