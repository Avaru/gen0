{
  "name": "gen0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check": "run-s lint:check \"test:unit -- --run\" build",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "format": "oxfmt src/"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pinia": "^4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "31.0.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": "24.x"
  }
